# ─────────────────────────────────────────────────────────────
# LegalOS — environment configuration
# Copy this file to `.env` and fill in the values below.
# ─────────────────────────────────────────────────────────────

# Database — Google Cloud SQL (PostgreSQL), database name: legalos-uat
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/legalos-uat
#
#  • Via Cloud SQL Auth Proxy (recommended for local/VM):
#      DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/legalos-uat
#  • Via Cloud SQL unix socket (Cloud Run / App Engine):
#      DATABASE_URL=postgresql+psycopg://USER:PASSWORD@/legalos-uat?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/legalos-uat

# Auth — use a long random string in every non-local environment
JWT_SECRET=replace-with-long-random-string

# AI backend: "stub" (no external calls) | "adk" (Google ADK agents) | "gemini" | "ollama"
AI_BACKEND=stub

# Allowed CORS origins (comma-separated) — set to the deployed frontend URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Optional ──────────────────────────────────────────────────
# Infosec: deployed envs load ALL app config from GCP Secret Manager JSON
# (legalos_dev / legalos_uat / legalos_prod). Env vars here only override.
# Do not hard-code secrets in source. Set LEGALOS_ENV to select the secret.
# LEGALOS_ENV=dev
# GCP_PROJECT_ID=
# GCP_SECRET_NAME=legalos_dev
# GCP_SERVICE_ACCOUNT_FILE=   # local only; GKE uses Workload Identity
# Local override only (optional): GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Google ADK agent layer (only when AI_BACKEND=adk) — powers UC-01 review and
# the prompt-based document editor. Gemini-direct models reuse GEMINI_API_KEY
# (set above / from Secret Manager) — there is no separate key to configure.
#
#  • Dev / pilot — Gemini direct (legal data leaves JFPSL infra):
#      ADK_MODEL=gemini-2.0-flash          # uses GEMINI_API_KEY
#
#  • Production — on-prem / self-hosted model via LiteLLM (data stays in-infra):
#      ADK_MODEL=ollama/llama3.1            # or openai/<deployed-model>
#      ADK_LITELLM_API_BASE=http://llm-gateway.internal:11434
#      ADK_LITELLM_API_KEY=<if the gateway needs one>
# ADK_MODEL=gemini-2.0-flash
# ADK_TEMPERATURE=0.2
# ADK_LITELLM_API_BASE=
# ADK_LITELLM_API_KEY=

# ── Gmail integration ─────────────────────────────────────────
# Requires Gmail API enabled + OAuth 2.0 Web client in Google Cloud Console.
# Redirect URI must match GMAIL_REDIRECT_URI exactly (per environment).
#
#  1. APIs & Services → Enable Gmail API, Google Drive API, Google Docs API, Google Sheets API
#  2. OAuth consent screen → add scopes (application feature map):
#       gmail.readonly   — read mail/threads/attachments (Task Manager, MSA poll)
#       gmail.send       — send mail (MSA vendor send, AI draft send)
#       gmail.modify     — label/message updates
#       gmail.metadata   — header-only listing
#       drive.file       — Drive files opened/created via LegalOS
#       documents        — native Google Docs (not covered by Drive alone)
#       spreadsheets     — native Google Sheets (not covered by Drive alone)
#  3. Credentials → OAuth 2.0 Client ID (Web application)
#  4. Authorized redirect URIs, e.g.:
#       http://localhost:8000/api/gmail/oauth/callback
#       https://legalos-dev.jiofinance.in/api/gmail/oauth/callback
#
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
# GMAIL_ENABLED=false
# GMAIL_POLL_INTERVAL_SECONDS=120
# GMAIL_LABEL=LegalOS/MSA

# ── MSA document storage ──────────────────────────────────────
# local = /tmp (lost if container/volume deleted)
# gcs   = durable gs://{LEGAL_TEMPLATES_BUCKET}/{MSA_DOCUMENTS_PREFIX}/…
# Live MSA/OnlyOffice docs use legal_live_docs/ under the legalos bucket.
DOCUMENT_STORAGE_BACKEND=gcs
LEGAL_TEMPLATES_BUCKET=legalos
MSA_DOCUMENTS_PREFIX=legal_live_docs
LEGAL_TEMPLATES_PREFIX=legal_templates
LEGAL_CONTRACTS_PREFIX=contracts
# LOCAL_STORAGE_PATH=/tmp/legalos-storage

# ── Email notifications (SMTP) ────────────────────────────────────────────────
# Simplest path (recommended for Docker/local): set the two SMTP_* values below.
# Env always overrides Secret Manager. Enable the feature with NOTIFICATIONS_ENABLED=true.
# NOTIFICATIONS_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=jfs-amp.notifications@jiofinance.in
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM_NAME=LegalOS Notifications
# FRONTEND_BASE_URL=http://localhost:5173
#
# Alternatively, load SMTP creds from Secret Manager (needs GCP creds in the
# container — a real service-account key mounted, or Workload Identity on GKE):
# SMTP_USERNAME_SECRET_NAME=brand_uat_EMAIL_SMTP_USERNAME
# SMTP_PASSWORD_SECRET_NAME=brand_uat_EMAIL_SMTP_PASSWORD
#
# Bootstrap password for the seeded real-email accounts (change after first login):
# SEED_DEFAULT_PASSWORD=password123

# Central IAM user sync (IAM_BACKEND_URL, IAM_CLIENT_SECRET, KEYCLOAK_CLIENT_ID)
# is loaded from GCP Secret Manager only — do not set in .env.

# ── Regulatory knowledge corpus (statutes / master directions / circulars) ────
# Postgres owns the clause chunks, provision labels, effective dates and
# supersession; embeddings are gemini-embedding-001 truncated to 768 dims.
# On by default — a corpus with nothing ingested simply returns no results.
# REGULATORY_RAG_ENABLED=true
# REGULATORY_RAG_MAX_RESULTS=8
# REGULATORY_EMBED_MODEL=gemini-embedding-001
# REGULATORY_EMBED_DIMS=768
#
# Optional second recall channel: a Vertex RAG corpus holding one text file per
# document. Purely additive — Postgres alone answers correctly without it.
# REGULATORY_VERTEX_SYNC_ENABLED=true
# REGULATORY_VERTEX_CORPUS_ID=  # id or full projects/.../ragCorpora/... resource
#
# Daily re-check of documents with a direct official URL and a changing cadence.
# Manual-download rows are flagged "stale" on the admin page instead.
# Enable in Dev/UAT so corpus freshness stays healthy; keep off in prod until
# ops confirms fetch credentials and review cadence.
# REGULATORY_REFRESH_ENABLED=true
# REGULATORY_REFRESH_INTERVAL_SECONDS=86400

# ── Research mode ─────────────────────────────────────────────────────────────
# Fan-out retrieves the corpus, official regulator sites and the open web in
# parallel before the agent answers. Off by default in code for safe local/prod.
# Enable both in Dev/UAT after the regulatory eval harness is green:
#   docker exec -e RUN_RAG_EVAL=1 legalos-backend python -m pytest tests/eval -q -s
# ORCH_RESEARCH_FANOUT_ENABLED=true
# ORCH_RESEARCH_LANE_TIMEOUT_SECONDS=20
# Audits every [n] citation against the excerpt it points at and marks
# unsupported claims [unverified]. Costs one extra LLM call per research answer.
# ORCH_RESEARCH_VERIFY_ENABLED=true

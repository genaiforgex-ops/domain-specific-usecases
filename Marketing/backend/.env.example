# Copy to .env and adjust. The backend reads these on startup.
# No Secret Manager / SSO — everything loads from this file.

# Postgres connection (SQLAlchemy URL)
# Inside Docker Compose, DATABASE_URL is overridden to use host `db`.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/orchestration

# JWT signing — change this in any real deployment
JWT_SECRET=change-me-to-a-long-random-string-genaiforge-local
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Environment label (local / development / production)
ENVIRONMENT=local

# CORS — SPA origin(s), comma-separated
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Public API origin (optional; used for absolute links)
PUBLIC_BASE_URL=http://localhost:8000
# SPA origin when split from the API (Docker nginx same-origin can leave blank)
FRONTEND_BASE_URL=http://localhost:5180

# Seed five role demo accounts on startup if missing
SEED_ON_STARTUP=true
SEED_PASSWORD=demo1234

# AI (optional). Leave blank to run without Gemini until you add a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-2.5-flash-image

# Figma export (optional Designer flow)
FIGMA_OAUTH_PATH=~/.config/figma_agent/oauth.json
FIGMA_REDIRECT_URI=http://localhost:8000/api/figma/callback
FIGMA_POST_LOGIN_REDIRECT=http://localhost:5180
FIGMA_PLAN_KEY=

# Email (optional — leave EMAIL_ENABLED=false for local demos without SMTP)
EMAIL_FROM_NAME=GenAIForge Marketing
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_APPROVAL_TOKEN_SECRET=local-demo-approval-secret-change-me

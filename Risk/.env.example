# GenAIForge Risk — copy to .env and adjust.
# Everything loads from this file. No SSO / cloud secret manager.

# Database (Compose Postgres publishes on host 5433)
DATABASE_URL=postgresql+asyncpg://genaiforge:genaiforge@localhost:5433/genaiforge
DATABASE_URL_SYNC=postgresql://genaiforge:genaiforge@localhost:5433/genaiforge

# Object storage — local filesystem for demos
LOCAL_STORAGE_PATH=/tmp/genaiforge-documents
STORAGE_ADAPTER=local

# Adapters (mock = safe local defaults)
SSO_ADAPTER=jwt
OSINT_ADAPTER=mock
EMAIL_ADAPTER=mock

# Optional SMTP (leave EMAIL_ADAPTER=mock to skip sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=noreply@genaiforge.local
SMTP_USERNAME=
SMTP_PASSWORD=

# App
SECRET_KEY=change-me-genaiforge-local-demo
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000
ENVIRONMENT=local
PUBLIC_BASE_URL=http://localhost:8002
FRONTEND_BASE_URL=http://localhost:5174

# Demo accounts created on API startup
SEED_PASSWORD=demo1234

# AI (optional — leave blank to run without live Gemini)
GEMINI_API_KEY=

# M1 defaults
M1_CONFIDENCE_THRESHOLD=0.70
M1_USE_CODE_PROMPT=true
